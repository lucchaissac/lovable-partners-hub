{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {"source":"/brand","destination":"/brand/index.html"},
    {"source":"/partners","destination":"/partners/index.html"},
    {"source":"/community","destination":"/community/index.html"},
    {"source":"/tech-blog","destination":"/tech-blog/index.html"}
  ],
  "functions": {"api/community-chat.mjs":{"maxDuration":300,"includeFiles":"public/{fonts/CameraPlain-Bold.ttf,ambassadors/assets/CameraPlain-Regular.ttf,ambassadors/previews/*.webp,ambassadors/library/*}"}}
}
