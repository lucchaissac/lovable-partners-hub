# Copy to .env.local. No server secret may use a VITE_ prefix.
# Codex remains a localhost-only option. Production accepts openai only.
COMMUNITY_CHAT_PROVIDER=codex
# Lovable image review in local Make uses the existing Codex sign-in.
# Set openai only for the same explicitly authorized, budget-limited demo below.
BRAND_CHAT_PROVIDER=codex
# For an explicitly authorized, budget-limited OpenAI demo:
OPENAI_API_KEY=
COMMUNITY_OPENAI_PROJECT=
COMMUNITY_OPENAI_EXPIRES_AT=
COMMUNITY_BUDGET_PATH=
BLOB_READ_WRITE_TOKEN=
COMMUNITY_PUBLIC_ORIGIN=https://lovable-brands.vercel.app

# Isolated landing-page demo. false / 0 / off removes its build entry.
# Restart Vite or rebuild after changing this. Never added to hub navigation.
DEMO_OPPORTUNITIES_ENABLED=true
