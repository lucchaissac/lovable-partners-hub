{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/demo/1000-opportunities/",
      "destination": "/1000-opportunities",
      "permanent": true
    },
    {
      "source": "/demo/1000-opportunities/:path*",
      "destination": "/1000-opportunities",
      "permanent": true
    },
    {
      "source": "/1000-opportunities/",
      "destination": "/1000-opportunities",
      "permanent": true
    },
    {
      "source": "/1000-opportunities/index.html",
      "destination": "/1000-opportunities",
      "permanent": true
    },
    {
      "source": "/holiday-playbook",
      "destination": "/brand#brand/create/c1a8bf00-24e8-4452-91bc-0b72126f0b53",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/1000-opportunities/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/demo/1000-opportunities/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/developers",
      "destination": "/developers.html"
    },
    {
      "source": "/api/hub/v1/:path*",
      "destination": "/api/hub?path=:path*"
    },
    {
      "source": "/1000-opportunities",
      "destination": "/demo/1000-opportunities/index.html"
    },
    {
      "source": "/brand",
      "destination": "/brand/index.html"
    },
    {
      "source": "/partners",
      "destination": "/partners/index.html"
    },
    {
      "source": "/community",
      "destination": "/community/index.html"
    },
    {
      "source": "/tech-blog",
      "destination": "/tech-blog/index.html"
    }
  ],
  "functions": {
    "api/community-chat.mjs": {
      "maxDuration": 300,
      "includeFiles": "public/{fonts/CameraPlain-Bold.ttf,ambassadors/assets/CameraPlain-Regular.ttf,ambassadors/previews/*.webp,ambassadors/library/*}"
    },
    "api/studio-animation.mjs": {
      "maxDuration": 300
    },
    "api/brand-review.mjs": {
      "maxDuration": 300,
      "includeFiles": "public/{brand/assets/*.svg,brand/previews/event-review.png,ambassadors/assets/heart-overlay.webp}"
    },
    "api/hub.mjs": {
      "maxDuration": 60,
      "includeFiles": "server/generated/**"
    }
  }
}
