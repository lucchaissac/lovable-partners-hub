{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@asset/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@asset/ui/theme": [
        "./packages/ui/src/theme.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "src/main.tsx"
  ]
}
