{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {"source":"/demo/1000-opportunities/","destination":"/1000-opportunities","permanent":true},
    {"source":"/demo/1000-opportunities/:path*","destination":"/1000-opportunities","permanent":true},
    {"source":"/1000-opportunities/","destination":"/1000-opportunities","permanent":true},
    {"source":"/1000-opportunities/index.html","destination":"/1000-opportunities","permanent":true}
  ],
  "headers": [
    {"source":"/1000-opportunities/:path*","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {"source":"/demo/1000-opportunities/:path*","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ],
  "rewrites": [
    {"source":"/1000-opportunities","destination":"/demo/1000-opportunities/index.html"},
    {"source":"/brand","destination":"/brand/index.html"},
    {"source":"/partners","destination":"/partners/index.html"},
    {"source":"/community","destination":"/community/index.html"},
    {"source":"/tech-blog","destination":"/tech-blog/index.html"}
  ],
  "functions": {"api/community-chat.mjs":{"maxDuration":300,"includeFiles":"public/{fonts/CameraPlain-Bold.ttf,ambassadors/assets/CameraPlain-Regular.ttf,ambassadors/previews/*.webp,ambassadors/library/*}"}}
}
