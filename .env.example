# Copy to .env.local. No server secret may use a VITE_ prefix.
# Codex remains a localhost-only option. Production accepts openai only.
COMMUNITY_CHAT_PROVIDER=codex
# For an explicitly authorized, budget-limited OpenAI demo:
OPENAI_API_KEY=
COMMUNITY_OPENAI_PROJECT=
COMMUNITY_OPENAI_EXPIRES_AT=
COMMUNITY_BUDGET_PATH=
BLOB_READ_WRITE_TOKEN=
COMMUNITY_PUBLIC_ORIGIN=https://lovable-brands.vercel.app
